{
  "name": "maguna",
  "description": "Tauri desktop app (Helvety Maguna) for GGUF models — catalog, download, import, on-device inference (Chat, correction/translate, custom modes), per-mode prompts and model bindings, always-on output guardrails (optional custom policy text), Settings (terms, acceptable use, disclaimers), archives in localStorage, light/dark theme, copy controls",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-llama-cmake-cache.mjs && tauri dev",
    "dev:shell": "tauri dev -- --no-default-features",
    "dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-windows.ps1",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:app": "node scripts/ensure-llama-cmake-cache.mjs && node scripts/tauri-build.mjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --no-default-features --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:rust:llama": "node scripts/ensure-llama-cmake-cache.mjs && cargo test --manifest-path src-tauri/Cargo.toml --features llama chat_template",
    "check": "bun run format:check && bun run lint && bun run test && bun run build && bun run check:rust"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  }
}
